# Cloudflare API Token - 在 https://dash.cloudflare.com/profile/api-tokens 创建
# 需要权限: Cloudflare Pages: Edit
CLOUDFLARE_API_TOKEN=

# Cloudflare Account ID - 在 Workers/Pages 概览页右侧获取
CLOUDFLARE_ACCOUNT_ID=

# Supabase（可选，云同步）。anon key 是公开值，安全由 RLS 承担（见 docs/SUPABASE.md）；
# 切勿在此出现 service_role key。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
